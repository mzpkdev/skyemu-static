{
  "name": "skyemu-static",
  "version": "0.0.2",
  "description": "Install-ready SkyEmu v5 Linux x64 binary",
  "keywords": [
    "binary",
    "linux",
    "skyemu",
    "x64"
  ],
  "homepage": "https://github.com/mzpkdev/skyemu-static#readme",
  "bugs": {
    "url": "https://github.com/mzpkdev/skyemu-static/issues"
  },
  "license": "MIT",
  "author": "Mateusz Pietrzak <mateusz@mzpk.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mzpkdev/skyemu-static.git"
  },
  "files": [
    "dist",
    "types",
    "vendor/SkyEmu",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "wa build",
    "build:release": "pnpm run build && pnpm run build:skyemu",
    "build:skyemu": "node scripts/build-skyemu.mjs",
    "check": "wa check",
    "format": "wa format",
    "lint": "wa lint",
    "prepack": "pnpm run build:release",
    "prepublishOnly": "wa check && node --test --test-concurrency=1 test/*.test.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:smoke": "node --test test/install.test.mjs",
    "typecheck": "wa typecheck"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2",
    "webanvil": "0.0.17"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@11.9.0"
}
